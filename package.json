{
  "name": "mint-notes",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "pnpm prepare:editor && concurrently -k -n web,api -c cyan,magenta \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "pnpm prepare:editor && vite",
    "dev:server": "tsx watch server/index.ts",
    "typecheck": "pnpm prepare:editor && tsc --noEmit && tsc -p server/tsconfig.json --noEmit && tsc -p tests/editor/browser/tsconfig.json --noEmit",
    "test": "pnpm prepare:editor && vitest run",
    "test:crypto-worker": "node scripts/test-crypto-worker.mjs",
    "test:smoke": "node scripts/smoke-api.mjs",
    "release:version": "node scripts/release-version.mjs",
    "build:web": "pnpm prepare:editor && vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "build": "pnpm prepare:editor && vite build && tsc -p server/tsconfig.json",
    "start": "node server-dist/index.js",
    "backup": "node server-dist/backup.js",
    "prepare:editor": "node scripts/prepare-typora-web.mjs",
    "test:upstream": "pnpm prepare:editor && vitest run --config vitest.upstream.config.ts",
    "test:patched-upstream": "pnpm prepare:editor && vitest run --config vitest.patched-upstream.config.ts",
    "test:editor-browser": "pnpm prepare:editor && vite build --config tests/editor/browser/vite.config.ts && playwright test"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.3",
    "better-sqlite3": "^12.2.0",
    "fastify": "^5.12.4",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/markdown-it": "^14.1.2",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.0.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "@zip.js/zip.js": "^2.18.2",
    "concurrently": "^9.2.0",
    "dexie": "^4.0.11",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^18.0.1",
    "hash-wasm": "^4.12.0",
    "highlight.js": "^11.12.0",
    "jszip": "^3.10.1",
    "katex": "^0.18.1",
    "lucide-react": "^1.25.0",
    "markdown-it": "^14.1.1",
    "markdown-it-emoji": "^3.0.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mermaid": "^11.17.2",
    "micromark": "^4.0.3",
    "pino-pretty": "^13.1.3",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-history": "^1.5.0",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.4",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.0",
    "prosemirror-view": "^1.41.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.1",
    "vitest": "^3.2.4",
    "workbox-window": "^7.3.0",
    "yaml": "^2.9.0"
  }
}
