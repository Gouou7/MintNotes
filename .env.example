# Non-zero numeric Linux user and group IDs used to run the container.
# Match these to the owner of ./notes-data (typically `id -u` and `id -g`).
PUID=1000
PGID=1000

# Address the Fastify server listens on inside the container.
# Keep 0.0.0.0 when using Docker Compose so the published port can reach it.
HOST=0.0.0.0

# HTTP port inside the container. Keep this aligned with the Compose port
# mapping and health check unless all three are changed together.
PORT=8787

# Minimum terminal log level. Supported values are trace, debug, info, warn,
# error, fatal, and silent. Production emits JSON; development uses readable text.
LOG_LEVEL=info

# Allow anyone to register after the first bootstrap administrator exists.
# Administrator-issued activation codes continue to work when this is false.
ALLOW_REGISTRATION=false

# Maximum encrypted attachment size accepted by the server, in MiB.
# The bundled browser client separately enforces a 25 MiB raster-image limit.
MAX_ATTACHMENT_SIZE_MB=25

# Maximum encrypted object-revision and attachment-chunk storage assigned to each user, in MiB.
USER_STORAGE_QUOTA_MB=2048

# Maximum encrypted note-history storage assigned to each user, in MiB.
# This is independent from USER_STORAGE_QUOTA_MB.
USER_HISTORY_QUOTA_MB=256

# Lifetime of a normal, non-remembered login session, in hours.
SESSION_TTL_HOURS=168

# Advanced: standard deployment uses a controlled HTTPS reverse proxy and
# a loopback-only backend port. Leave true with the supplied proxy example.
# Set false for direct development access; never expose a trusted backend publicly.
TRUST_PROXY=true

# Optional: leave empty to check same-origin requests automatically.
# To restrict access to one origin, set an exact HTTPS origin including any
# non-default port, with no path or trailing slash: https://notes.example.com
APP_ORIGIN=
