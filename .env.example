# 运行容器的非 root Linux 用户与组 ID。
# 应与 ./notes-data 目录的所有者一致（通常用 `id -u` 和 `id -g` 查看）。
PUID=1000
PGID=1000

# Fastify 服务在容器内的监听地址。
# 使用 Docker Compose 时保持 0.0.0.0，端口映射才能访问到服务。
HOST=0.0.0.0

# 容器内的 HTTP 端口。除非同时修改端口映射与健康检查，否则保持一致。
PORT=8787

# 最低终端日志级别，支持 trace、debug、info、warn、error、fatal、silent。
# 生产输出 JSON，开发输出可读文本。
LOG_LEVEL=info

# 首个管理员账户建立后，是否允许任何人自行注册。
# 该值为 false 时，管理员签发的一次性激活码仍然可用。
ALLOW_REGISTRATION=false

# 服务端接受的最大加密附件大小，单位 MiB。
# 浏览器客户端另行固定 25 MiB 的栅格图片上限。
MAX_ATTACHMENT_SIZE_MB=25

# 每个用户可用的加密对象修订与附件分块存储上限，单位 MiB。
USER_STORAGE_QUOTA_MB=2048

# 每个用户可用的加密历史存储上限，单位 MiB；与 USER_STORAGE_QUOTA_MB 相互独立。
USER_HISTORY_QUOTA_MB=256

# 普通（未记住设备）登录会话的有效期，单位小时。
SESSION_TTL_HOURS=168

# 高级选项：标准部署使用受控的 HTTPS 反向代理与仅回环的后端端口，
# 配合随附的代理示例保持 true。直接本地开发可设为 false，
# 不要把受信任的后端直接暴露到公网。
TRUST_PROXY=true

# 可选：留空时按请求自动校验同源。
# 如需固定单一来源，填写用户访问的精确 HTTPS 源，可含非默认端口，
# 不能带路径或末尾斜杠，例如：https://notes.example.com
APP_ORIGIN=
